+        // A spell defined in code (World of Skatecraft).
+        SpellEntry* AddCustomSpell(uint32 id)
+        {
+            if (id >= GetMaxSpellId())
+                mSpellEntryMap.resize(id + 1);
+            std::unique_ptr<SpellEntry> spell = std::make_unique<SpellEntry>();
+            spell->Id = id;
+            spell->Internal |= SPELL_INTERNAL_CUSTOM;
+            mSpellEntryMap[id] = std::move(spell);
+            mExistingSpellsSet.insert(id);
+            return mSpellEntryMap[id].get();
+        }
